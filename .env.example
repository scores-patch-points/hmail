# Public client config. For GitHub Pages, set these in repo Settings →
# Secrets and variables → Actions → Variables (they're public — they ship in
# the client bundle — so use Variables, not Secrets). A self-hosted build with
# no client ID baked in can instead paste its own in the app's "Connect Google"
# wizard (stored locally).

# The app's own Google OAuth client ID (Web application). Public by design.
# For the hosted deployment this is the VERIFIED client (see
# docs/google-oauth-setup.md and GOOGLE-OAUTH-VERIFICATION-hmail.md). When set,
# it always wins and the self-hosting wizard is hidden.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# The Matrix homeserver that hosts the operator's key-delivery account.
VITE_MATRIX_HOMESERVER=https://hyphae.social

# Who operates this deployment. Shown on setup. Never a form.
VITE_OWNER=hyphae

# Contact address rendered into the landing page, privacy policy and terms.
# Must be a mailbox someone reads: Google writes to it during verification.
VITE_SUPPORT_EMAIL=support@example.com

# "/" for a custom domain (the hosted deployment is mail.hyphae.social).
# Only set this to "/hmail/" for a github.io project-site deploy.
# VITE_BASE_PATH=/
